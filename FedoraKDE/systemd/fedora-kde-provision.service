[Unit]
Description=FedoraKDE first-boot provisioning
Documentation=file:///root/FedoraKDE/docs/RUNBOOK.md
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/log/fedora-kde/state/provisioned

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/root/FedoraKDE/install.sh provision --yes --auto
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
