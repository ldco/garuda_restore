# Shared %pre/%post sections for both media.
%pre
{
  model="$(cat /sys/block/nvme1n1/device/model 2>/dev/null | xargs)"
  bytes="$(blockdev --getsize64 /dev/nvme1n1 2>/dev/null || echo 0)"
  echo "FedoraKDE pre: nvme1n1 model='${model}' bytes=${bytes}" >/dev/console
  if [ "$model" != "INTEL SSDPEKNU512GZ" ]; then
    echo "FedoraKDE pre: REFUSING - unexpected model '${model}' (expected INTEL SSDPEKNU512GZ)" >/dev/console
    exit 1
  fi
  if [ "$bytes" -lt 480000000000 ] || [ "$bytes" -gt 540000000000 ]; then
    echo "FedoraKDE pre: REFUSING - unexpected size ${bytes} (expected ~512GB)" >/dev/console
    exit 1
  fi
} 2>&1
%end

%post --log=/root/fedora-kde-post.log
set -eu
echo "ldco" > /etc/hostname
mkdir -p /etc/fedora-kde
date -Is > /etc/fedora-kde/installed
cat /proc/sys/kernel/random/uuid > /etc/fedora-kde/install-id

# Add btrfs mount options (idempotent).
python3 - <<'PY'
p = "/etc/fstab"
opts = "noatime,compress=zstd:3,ssd,discard=async,space_cache=v2".split(",")
try:
    lines = open(p, encoding="utf-8").read().splitlines()
except OSError:
    lines = []
out = []
for ln in lines:
    f = ln.split()
    if ln.strip().startswith("#") or len(f) < 4:
        out.append(ln)
        continue
    if f[2] == "btrfs":
        current = f[3].split(",")
        for opt in opts:
            if opt not in current:
                current.append(opt)
        f[3] = ",".join(current)
        out.append(" ".join(f))
    else:
        out.append(ln)
open(p, "w", encoding="utf-8").write("\n".join(out) + "\n")
PY

# Pick up the provisioning bundle from the OEMDRV partition, if present.
mkdir -p /mnt/oem
if mount LABEL=OEMDRV /mnt/oem 2>/dev/null; then
    if [ -f /mnt/oem/FedoraKDE.tar.gz ]; then
        tar -xzf /mnt/oem/FedoraKDE.tar.gz -C /root/
    fi
    if [ -f /mnt/oem/auto-provision ] && [ -f /root/FedoraKDE/systemd/fedora-kde-provision.service ]; then
        cp /root/FedoraKDE/systemd/fedora-kde-provision.service /etc/systemd/system/
        systemctl enable fedora-kde-provision.service || true
    fi
    umount /mnt/oem
fi
touch /etc/fedora-kde/provision-pending
%end
