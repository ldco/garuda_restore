{
  "project": "garuda-restore",
  "version": "2.0.0",
  "stack": {
    "type": "shell-scripts",
    "platform": "Garuda Linux (Arch-based)",
    "desktop": "KDE Plasma",
    "language": "Bash"
  },
  "entryPoints": {
    "backup": "scripts/backup.sh",
    "restore": "scripts/restore.sh",
    "healthCheck": "scripts/tools/system-health-check.sh",
    "systemUpdate": "scripts/tools/system-update.sh",
    "detectHardware": "scripts/tools/detect-hardware.sh",
    "applyOptimizations": "scripts/tools/apply-optimizations.sh",
    "rollbackOptimizations": "scripts/tools/rollback-optimizations.sh",
    "dailyBackup": "scripts/daily-backup.sh",
    "setupBackup": "scripts/setup-daily-backup.sh"
  },
  "roles": ["shell", "linux", "security"],
  "defaultRole": "shell",
  "team": ["shell", "linux", "security"],
  "rag": {
    "enabled": false,
    "exclude": [
      "packages",
      "temp",
      ".git",
      "*.tar.gz"
    ]
  },
  "globalLibrary": "~/.claude"
}
